# kubectl user preferences, read from ~/.kube/kuberc (kubectl >= 1.34).
# Reference: https://kubernetes.io/docs/reference/kubectl/kuberc/
#
# Aliases are kubectl subcommands (`kubectl getw pods`), so the `k` alias for
# kubectl itself stays in .zshrc. Flags passed on the command line always win
# over the defaults set here. Bypass this file with KUBERC=off.
apiVersion: kubectl.config.k8s.io/v1beta1
kind: Preference

aliases:
  # kubectl getw pods   ->  kubectl get pods --output wide
  - name: getw
    command: get
    options:
      - name: output
        default: wide

  # kubectl gety deploy/api   ->  kubectl get deploy/api --output yaml
  - name: gety
    command: get
    options:
      - name: output
        default: yaml

  # kubectl logf deploy/api   ->  kubectl logs deploy/api --follow --timestamps
  - name: logf
    command: logs
    options:
      - name: follow
        default: "true"
      - name: timestamps
        default: "true"

defaults:
  # Ask before deleting anything; skip the prompt with --interactive=false.
  - command: delete
    options:
      - name: interactive
        default: "true"
